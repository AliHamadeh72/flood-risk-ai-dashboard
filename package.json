{
  "name": "flood-risk-ai-dashboard",
  "version": "1.0.0",
  "description": "Portfolio project for visualizing cadaster-level flood-risk indicators in Lebanon using a local cadaster shapefile, Open-Meteo weather data, and a grounded retrieval chatbot.",
  "main": "index.js",
  "scripts": {
    "build:predictions": "python ml/build_open_meteo_predictions.py",
    "refresh:open-meteo": "python ml/weekly_open_meteo_refresh.py",
    "mongo:upload-cadaster-risk": "node scripts/upload-cadaster-risk-to-mongodb.js",
    "pipeline:refresh-and-upload": "npm run refresh:open-meteo && npm run mongo:upload-cadaster-risk",
    "test": "node -e \"require('./api/push-send.js'); require('./api/push-subscriptions.js'); require('./api/test-risk-alert.js'); console.log('api ok')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliHamadeh72/flood-risk-ai-dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AliHamadeh72/flood-risk-ai-dashboard/issues"
  },
  "homepage": "https://github.com/AliHamadeh72/flood-risk-ai-dashboard#readme",
  "dependencies": {
    "mongodb": "^7.3.0",
    "web-push": "^3.6.7"
  }
}
